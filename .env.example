# --- Guestbook persistence (Upstash Redis via Vercel Marketplace) ---
# Without these set, the guestbook falls back to an in-memory store
# (fine for local dev; data resets on restart and is NOT shared across
# serverless instances in production — set these for real persistence).
#
# Get them by adding the "Upstash" integration from the Vercel Marketplace
# (Vercel dashboard → Storage → Marketplace → Upstash Redis), or from
# https://console.upstash.com for a standalone database.
KV_REST_API_URL=
KV_REST_API_TOKEN=
